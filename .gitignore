.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
# pytest-cov output; coverage is read in the terminal, not committed.
.coverage
.coverage.*
coverage.xml
htmlcov/
# hatchling build products of the two workspace members.
build/
dist/
# Single output area: all run artifacts (renovated renders, guidance traces,
# depth/mask debug dumps, experiment results) default here via ROOMGEN_WDIR.
/outputs/
# Input sink: source room photographs and their derived depth/segmentation
# caches. Large binaries, and the photos are generally not ours to redistribute.
/data/
# Repo-pinned Hugging Face cache (HF_HOME): tens of GB of pretrained diffusion,
# depth and segmentation weights, fetched on demand rather than committed.
/.cache/huggingface/
wandb/
*.egg-info/
# Checkpoints are never committed, wherever they land: a weight file that
# escapes the caches above is caught here rather than in review.
*.ckpt
*.pt
*.pth
*.safetensors
# Editor and OS droppings.
.idea/
.vscode/
.DS_Store
