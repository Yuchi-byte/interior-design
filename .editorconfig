# Settles in the editor what the pre-commit hygiene hooks would otherwise
# settle after the fact: encoding, line endings, and the trailing newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Matches ruff's line-length in the root pyproject.
max_line_length = 88

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; the trailing-whitespace
# hook is configured to spare .md for the same reason.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
